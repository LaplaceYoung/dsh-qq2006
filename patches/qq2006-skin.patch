+/* QQComposerChrome: the small toolbar (its own line above the input card,
+   riding the composer's shared width axis) and the bottom button row (the
+   band under the card). All rules are skin-scoped; the components also
+   render nothing outside the skin, so the default composer DOM is byte-for-
+   byte unchanged. */
+
+.dockRow {
+  box-sizing: border-box;
+  flex: none;
+  width: calc(
+    100% -
+    var(--dsh-composer-side-clearance) -
+    var(--dsh-composer-side-clearance) -
+    var(--dsh-composer-dock-inset) -
+    var(--dsh-composer-dock-inset)
+  );
+  max-width: calc(
+    var(--dsh-composer-card-max-width) -
+    var(--dsh-composer-dock-inset) -
+    var(--dsh-composer-dock-inset)
+  );
+  margin: 0 auto;
+  padding: 0 var(--dsh-composer-dock-inset);
+  /* 紧贴输入框上沿：composer 栈在 dock 行与输入卡片之间留了
+     --dsh-composer-stack-gap(6px) 的缝，QQ2006 原版工具栏与输入框之间
+     没有缝隙（原版 .qq-im-chat-toolbar 直接压在 textarea 上方），用负
+     margin 抵消该 gap 使钮行与卡片上沿对齐。仅皮肤下渲染本行，默认
+     皮肤 DOM 不含此元素。 */
+  margin-bottom: calc(-1 * var(--dsh-composer-stack-gap, 6px));
+}
+
+.toolbar {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  box-sizing: border-box;
+  /* 原版 .qq-im-chat-toolbar 高 20px、钮 18×18、间距 4px。 */
+  height: 20px;
+  padding: 0 4px;
+  border: 1px solid rgb(160, 196, 226);
+  border-bottom: none;
+  border-radius: 6px 6px 0 0;
+  background:
+    /* IMSmallToolbarBackground.png is a 22×22 tile: light body + a 4px dark
+       bottom border. Stretch it to the strip's full height so the dark edge
+       lands at the strip bottom (natural 22px would leave a gradient gap
+       under it); the 22px repeat width stays native. */
+    url('/qq2006/img/im/IMSmallToolbarBackground.png') center top / 22px 100% repeat-x,
+    linear-gradient(to bottom, rgb(240, 248, 254), rgb(222, 238, 250));
+}
+
+.smallButton {
+  display: grid;
+  place-items: center;
+  /* 原版 18×18 钮（原版 .qq-im-chat-toolbar button）。 */
+  width: 18px;
+  height: 18px;
+  padding: 0;
+  border: 1px solid transparent;
+  border-radius: 3px;
+  background: transparent;
+  cursor: pointer;
+}
+
+.smallButton:hover {
+  /* 原版 hover：border rgb(135,164,197) + bg rgb(183,214,245)。 */
+  border-color: rgb(135, 164, 197);
+  background-color: rgb(183, 214, 245);
+}
+
+.smallButton:active {
+  /* 原版 active：border rgb(109,146,186) + bg rgb(170,200,230)。 */
+  border-color: rgb(109, 146, 186);
+  background-color: rgb(170, 200, 230);
+}
+
+.smallIcon {
+  /* Native IMSmallToolbar asset size (16×16) — pixel-sharp, no upscale blur. */
+  width: 16px;
+  height: 16px;
+  pointer-events: none;
+}
+
+/* 原版 A 字体/表情/其他 之后的分隔线（原版 .qq-im-chat-toolbar span：
