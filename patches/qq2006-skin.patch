+/* QQ2006 skin sheet — the global half of the skin.
+ *
+ * Scope discipline: EVERY rule in this file is anchored to
+ * `body[data-ds-skin='qq2006']`, the attribute the ui-skin-qq2006 plugin
+ * mirrors (and boot.tsx restores before the loading page renders). The
+ * default skin is therefore untouched by this file.
+ *
+ * Contents: retro typography, selection, scrollbars, and the shared skin
+ * kit — the classic three-slice window chrome (.qq-skin-title / .qq-skin-head
+ * / .qq-skin-body), three-state title buttons, and the gradient .qq-btn.
+ * Component-level patches (conversation bubbles, sidebar rows, composer…)
+ * live in each component's own .module.css, scoped the same way:
+ *
+ *   body[data-ds-skin='qq2006'] .localClass { … }
+ *
+ * Assets referenced below are served from apps/web/public/qq2006/ (copied
+ * from the mengkunsoft/QQ2006 reproduction; original QQ2006 assets,
+ * copyright Tencent, learning use only — see public/qq2006/README.txt).
+ */
+
+body[data-ds-skin='qq2006'] {
+  font-family: Tahoma, 'SimSun', '宋体', 'Microsoft YaHei', sans-serif;
+  /* Coral-blue alias tokens come from the ui-theme sheet (QQ2006_TOKENS);
+     the names below are the official --dsw-alias-* set. */
+  color: var(--dsw-alias-label-primary);
+}
+
+body[data-ds-skin='qq2006'] ::selection {
+  background: var(--dsw-alias-brand-primary);
+  color: var(--dsw-alias-label-primary-foreground);
+}
+
+/* ── retro scrollbars ─────────────────────────────────────────────────────── */
+body[data-ds-skin='qq2006'] {
+  scrollbar-width: thin;
+  scrollbar-color: var(--dsw-alias-border-l2) var(--dsw-alias-scrollbar-bg-l1);
+}
+body[data-ds-skin='qq2006'] ::-webkit-scrollbar {
+  width: 8px;
+  height: 8px;
+}
+body[data-ds-skin='qq2006'] ::-webkit-scrollbar-track {
+  background: var(--dsw-alias-scrollbar-bg-l1);
+}
+body[data-ds-skin='qq2006'] ::-webkit-scrollbar-thumb {
+  background: linear-gradient(to right, rgb(178, 205, 232), rgb(140, 178, 216));
+  border: 1px solid rgb(120, 165, 215);
+  border-radius: 4px;
+}
+body[data-ds-skin='qq2006'] ::-webkit-scrollbar-thumb:hover {
+  background: linear-gradient(to right, rgb(150, 190, 230), rgb(120, 165, 215));
+}
+
+/* ── nine-slice window chrome kit ────────────────────────────────────────────
+ * The 2006 skin is three horizontal bands (title / head / body), each a
+ * left cap + tiling center + right cap at natural size (the original tiles
+ * 10px-wide repeat patterns). Components compose them as background layers
+ * on one element — no extra DOM. Use the .qq-skin-* classes directly from
+ * TSX (they are :global utilities).
+ */
+body[data-ds-skin='qq2006'] .qq-skin-title {
+  background:
+    url('/qq2006/img/BackgroundTitleRight.png') right top no-repeat,
+    url('/qq2006/img/BackgroundTitleCenter.png') center top repeat-x,
+    url('/qq2006/img/BackgroundTitleLeft.png') left top no-repeat;
+  height: 24px;
+}
+
+body[data-ds-skin='qq2006'] .qq-skin-head {
+  background:
+    url('/qq2006/img/BackgroundTitleRight2.png') right top no-repeat,
+    url('/qq2006/img/BackgroundTitleCenter2.png') center top repeat-x,
+    url('/qq2006/img/BackgroundTitleLeft2.png') left top no-repeat;
+  /* Full natural band height (BackgroundTitle2* are 61px tall); showing the
+     whole tile keeps the toolbar surface AND the dark bottom strip that the
+     original QQ2006 toolbar band carries. */
+  height: 61px;
+}
+
+body[data-ds-skin='qq2006'] .qq-skin-body {
+  background:
+    url('/qq2006/img/BackgroundR.png') right top repeat-y,
+    url('/qq2006/img/BackgroundC.png') center top repeat,
+    url('/qq2006/img/BackgroundL.png') left top repeat-y;
+}
+
+/* ── three-state title buttons (16×16, Normal/Hover/Down) ─────────────────── */
+body[data-ds-skin='qq2006'] .qq-skin-btn-min,
+body[data-ds-skin='qq2006'] .qq-skin-btn-menu,
+body[data-ds-skin='qq2006'] .qq-skin-btn-color,
+body[data-ds-skin='qq2006'] .qq-skin-btn-close {
+  width: 16px;
+  height: 16px;
+  border: 0;
+  padding: 0;
+  cursor: pointer;
+  background-color: transparent;
+}
+/* 菜单 is a 65×24 text button in the original QQ2006 (MenuButton_*.png are
+   65×24 — a green gradient button with the white 菜单 label), not a 16×16
+   icon. Display it at native size; the title strip is 24px tall so it fills
+   the band exactly and sits level with the 16×16 color/min/close buttons. */
+body[data-ds-skin='qq2006'] .qq-skin-btn-menu {
+  width: 65px;
+  height: 24px;
+  background-size: 65px 24px;
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-menu {
+  background-image: url('/qq2006/img/MenuButton_Normal.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-menu:hover {
+  background-image: url('/qq2006/img/MenuButton_Hover.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-menu:active {
+  background-image: url('/qq2006/img/MenuButton_Down.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-min {
+  background-image: url('/qq2006/img/MinButton_Normal.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-min:hover {
+  background-image: url('/qq2006/img/MinButton_Hover.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-min:active {
+  background-image: url('/qq2006/img/MinButton_Down.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-color {
+  background-image: url('/qq2006/img/ColorButton_Normal.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-color:hover {
+  background-image: url('/qq2006/img/ColorButton_Hover.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-color:active {
+  background-image: url('/qq2006/img/ColorButton_Down.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-close {
+  background-image: url('/qq2006/img/CloseButton_Normal.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-close:hover {
+  background-image: url('/qq2006/img/CloseButton_Hover.png');
+}
+body[data-ds-skin='qq2006'] .qq-skin-btn-close:active {
+  background-image: url('/qq2006/img/CloseButton_Down.png');
+}
+
+/* ── classic gradient button (replica of the original .qq-btn) ────────────── */
+body[data-ds-skin='qq2006'] .qq-btn {
+  font-size: 12px;
+  line-height: 1.6;
+  font-family: inherit;
+  background: linear-gradient(to bottom, #ffffff, #9fd4ff);
+  border: 1px solid #00558e;
+  border-radius: 3px;
+  cursor: pointer;
+  color: rgb(20, 40, 70);
+  padding: 1px 8px;
+}
+body[data-ds-skin='qq2006'] .qq-btn:focus {
+  box-shadow: inset 0 0 0 1px #ffe762, inset 0 0 0 2px #fcb833;
+}
+body[data-ds-skin='qq2006'] .qq-btn:hover {
+  background: linear-gradient(to bottom, #ffffff, #b9e1ff);
+}
+body[data-ds-skin='qq2006'] .qq-btn:active {
+  background: linear-gradient(to bottom, #97c5ec, #d2f8fd);
+}
+
+/* ── status pill (在线/离线…) ─────────────────────────────────────────────── */
+body[data-ds-skin='qq2006'] .qq-skin-status {
+  display: inline-block;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  border: 1px solid var(--dsw-alias-border-l3);
+}
+body[data-ds-skin='qq2006'] .qq-skin-status-on {
+  background: var(--dsw-alias-state-success-primary);
+}
+body[data-ds-skin='qq2006'] .qq-skin-status-off {
+  background: rgb(170, 180, 192);
+}
+
+/* ── global keyboard-focus ring: the QQ golden outline everywhere ──
+ * warn-primary is the QQ2006 amber (#e69628 family) carried by the alias
+ * token overrides; the golden focus ring rides it so the sheet stays
+ * token-driven. */
+body[data-ds-skin='qq2006'] :focus-visible {
+  outline: 2px solid var(--dsw-alias-state-warn-primary);
+  outline-offset: 1px;
+}
+
+/* ── message font-size cycle (the A toolbar button): 小/中/大 ── */
+body[data-ds-skin='qq2006'] {
+  --qq-msg-font-size: 13px;
+}
+body[data-ds-skin='qq2006'][data-qq-font='s'] {
+  --qq-msg-font-size: 12px;
+}
+body[data-ds-skin='qq2006'][data-qq-font='l'] {
+  --qq-msg-font-size: 15px;
+}
